<!DOCTYPE html>
<html>

<head>

<title>Edit Invoice</title>

</head>


<body>


<h2>Edit Invoice</h2>


<a href="/invoices">
Back to Invoices
</a>


<br><br>


<form action="/invoices/edit/<%= invoice.invoice_id %>" method="POST">


<label>
Invoice Number
</label>

<br>

<input
type="text"
value="<%= invoice.invoice_number %>"
readonly
>


<br><br>


<label>
Invoice Date
</label>

<br>

<input
type="date"
name="invoice_date"
value="<%= invoice.invoice_date ? invoice.invoice_date.toISOString().split('T')[0] : '' %>"
required
>


<br><br>


<label>
GST
</label>

<br>

<input
type="number"
step="0.01"
name="gst"
value="<%= invoice.gst %>"
>


<br><br>


<label>
Discount
</label>

<br>

<input
type="number"
step="0.01"
name="discount"
value="<%= invoice.discount %>"
>


<br><br>


<label>
Grand Total
</label>

<br>

<input
type="number"
step="0.01"
name="grand_total"
value="<%= invoice.grand_total %>"
required
>


<br><br>


<button type="submit">
Update Invoice
</button>


</form>


</body>

</html>