<!DOCTYPE html>
<html>

<head>
    <title>Add Estimate</title>
</head>

<body>

<h2>Add Estimate</h2>

<a href="/estimates">Back to Estimates</a>

<br><br>

<form action="/estimates/add" method="POST">

    <label>Group</label><br>
    <select name="group_id" required>
        <option value="">Select Group</option>

        <% groups.forEach(group => { %>

        <option value="<%= group.group_id %>">
            <%= group.group_name %>
        </option>

        <% }) %>

    </select>

    <br><br>

    <label>Chain</label><br>

    <select name="chain_id" required>

        <option value="">Select Chain</option>

        <% chains.forEach(chain => { %>

        <option value="<%= chain.chain_id %>">
            <%= chain.company_name %>
        </option>

        <% }) %>

    </select>

    <br><br>

    <label>Zone</label><br>

    <select name="zone_id" required>

        <option value="">Select Zone</option>

        <% zones.forEach(zone => { %>

        <option value="<%= zone.zone_id %>">
            <%= zone.zone_name %>
        </option>

        <% }) %>

    </select>

    <br><br>

    <label>Brand</label><br>

    <select name="brand_id" required>

        <option value="">Select Brand</option>

        <% brands.forEach(brand => { %>

        <option value="<%= brand.brand_id %>">
            <%= brand.brand_name %>
        </option>

        <% }) %>

    </select>

    <br><br>

    <label>Service</label><br>

    <input
        type="text"
        name="service"
        required
    >

    <br><br>

    <label>Quantity</label><br>

    <input
        type="number"
        id="quantity"
        name="quantity"
        min="1"
        required
    >

    <br><br>

    <label>Price Per Unit</label><br>

    <input
        type="number"
        id="price_per_unit"
        name="price_per_unit"
        step="0.01"
        min="0"
        required
    >

    <br><br>

    <label>Total Amount</label><br>

    <input
        type="number"
        id="total_amount"
        name="total_amount"
        step="0.01"
        readonly
    >

    <br><br>

    <label>Expected Delivery</label><br>

    <input
        type="date"
        name="expected_delivery"
    >

    <br><br>

    <label>Delivery Details</label><br>

    <textarea
        name="delivery_details"
        rows="4"
        cols="40"
    ></textarea>

    <br><br>

    <button type="submit">
        Save Estimate
    </button>

</form>

<script>

const quantity = document.getElementById("quantity");
const price = document.getElementById("price_per_unit");
const total = document.getElementById("total_amount");

function calculateTotal(){

    let qty = parseFloat(quantity.value) || 0;

    let rate = parseFloat(price.value) || 0;

    total.value = (qty * rate).toFixed(2);

}

quantity.addEventListener("keyup", calculateTotal);

price.addEventListener("keyup", calculateTotal);

quantity.addEventListener("change", calculateTotal);

price.addEventListener("change", calculateTotal);

</script>

</body>

</html>