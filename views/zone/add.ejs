<!DOCTYPE html>
<html>

<head>
    <title>Add Zone</title>
</head>

<body>

<h2>Add Zone</h2>

<a href="/zones">Back to Zones</a>

<br><br>

<form action="/zones/add" method="POST">

    <label>Zone Name:</label><br>

    <input
        type="text"
        name="zone_name"
        required
    >

    <br><br>

    <label>Select Chain:</label><br>

    <select name="chain_id" required>

        <option value="">Select Chain</option>

        <% chains.forEach(chain => { %>

            <option value="<%= chain.chain_id %>">
                <%= chain.company_name %>
            </option>

        <% }) %>

    </select>

    <br><br>

    <button type="submit">
        Add Zone
    </button>

</form>

</body>
</html>