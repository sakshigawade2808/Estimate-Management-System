<!DOCTYPE html>
<html>

<head>
<title>Add Chain</title>
</head>


<body>


<h2>Add Chain</h2>


<form action="/chains/add" method="POST">


<label>
Company Name
</label>

<input 
type="text"
name="company_name"
required>


<br><br>



<label>
Select Group
</label>


<select name="group_id">


<% groups.forEach(group => { %>

<option value="<%= group.group_id %>">

<%= group.group_name %>

</option>


<% }) %>


</select>


<br><br>


<button type="submit">
Save Chain
</button>


</form>


</body>

</html>