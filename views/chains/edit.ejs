<!DOCTYPE html>
<html>

<head>
    <title>Edit Chain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <h2>Edit Chain</h2>

    <form action="/chains/edit/<%= chain.chain_id %>" method="POST">

        <div class="mb-3">
            <label>Company Name</label>
            <input
                type="text"
                name="company_name"
                class="form-control"
                value="<%= chain.company_name %>"
                required>
        </div>

        <div class="mb-3">
            <label>Select Group</label>

            <select name="group_id" class="form-control">

                <% groups.forEach(group => { %>

                    <option
                        value="<%= group.group_id %>"
                        <%= chain.group_id == group.group_id ? "selected" : "" %>>
                        <%= group.group_name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <button class="btn btn-success">
            Update
        </button>

        <a href="/chains" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

</body>
</html>