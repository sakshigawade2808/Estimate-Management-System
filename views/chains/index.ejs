<!DOCTYPE html>
<html>

<head>
    <title>Chain Management</title>
</head>

<body>

<h2>Chain Management</h2>

<a href="/dashboard">Dashboard</a> |
<a href="/chains/add">Add Chain</a>

<br><br>

<table border="1" cellpadding="10">

<tr>
    <th>ID</th>
    <th>Company Name</th>
    <th>Group Name</th>
    <th>Action</th>
</tr>

<% if(chains.length > 0){ %>

    <% chains.forEach(chain => { %>

    <tr>
        <td><%= chain.chain_id %></td>

        <td><%= chain.company_name %></td>

        <td><%= chain.group_name %></td>

        <td>

            <a href="/chains/edit/<%= chain.chain_id %>">
                Edit
            </a>

            |

            <a href="/chains/delete/<%= chain.chain_id %>"
               onclick="return confirm('Are you sure you want to delete this chain?')">
                Delete
            </a>

        </td>

    </tr>

    <% }) %>

<% } else { %>

<tr>
    <td colspan="4" align="center">
        No Chains Available
    </td>
</tr>

<% } %>

</table>

</body>

</html>