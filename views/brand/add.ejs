<!DOCTYPE html>
<html>

<head>

<title>Add Brand</title>

</head>


<body>


<h2>Add Brand</h2>


<a href="/brands">
Back to Brands
</a>


<br><br>


<form action="/brands/add" method="POST">


<label>
Brand Name:
</label>


<input 
type="text"
name="brand_name"
required
>


<br><br>


<label>
Select SubZone:
</label>


<select name="subzone_id" required>


<option value="">
Select SubZone
</option>



<% subzones.forEach(subzone => { %>


<option value="<%= subzone.subzone_id %>">

<%= subzone.subzone_name %>

</option>


<% }) %>



</select>


<br><br>


<button type="submit">
Add Brand
</button>



</form>



</body>

</html>